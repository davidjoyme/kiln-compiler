// File: tests/lit/const_fold.kir
// RUN: %kiln-opt %s --passes=const-fold | FileCheck %s

// Scalar arithmetic folds; broadcasting a scalar does not (it would turn a
// free view into a 16 KiB constant).

graph @fold(%arg0: f32[64, 64]) -> (f32[64, 64]) {
  %0 = const {value = 2.0} : f32[]
  %1 = const {value = 3.0} : f32[]
  %2 = mul %0, %1 : f32[]
  %3 = expand %0 {shape = [64, 64]} : f32[64, 64]
  %4 = mul %arg0, %3 : f32[64, 64]
  %5 = add %4, %2 : f32[64, 64]
  return %5
}

// CHECK-LABEL: graph @fold
// CHECK:       const {value = 6.0} : f32[]
// CHECK:       expand
// CHECK-NOT:   mul %{{[0-9]+}}, %{{[0-9]+}} : f32[]
